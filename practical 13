<html>
<head>
<title>Mini Bootstrap Site</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body {
    font-family: 'Segoe UI', sans-serif;
}
.hero {
    background: linear-gradient(to right, #4facfe, #00f2fe);
    color: white;
    padding: 60px 20px;
    text-align: center;
}
.card:hover {
    transform: translateY(-5px);
    transition: 0.3s;
}
footer {
    background: #222;
    color: white;
    padding: 10px;
}
</style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
<div class="container">
<a class="navbar-brand" href="#">MySite</a>

<button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
<span class="navbar-toggler-icon"></span>
</button>

<div class="collapse navbar-collapse" id="menu">
<ul class="navbar-nav ms-auto">

<li class="nav-item"><a class="nav-link" href="#">Home</a></li>

<li class="nav-item dropdown">
<a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Services</a>
<ul class="dropdown-menu">
<li><a class="dropdown-item" href="#">Design</a></li>
<li><a class="dropdown-item" href="#">Development</a></li>
</ul>
</li>

<li class="nav-item"><a class="nav-link" href="#">Contact</a></li>

</ul>
</div>
</div>
</nav>

<div class="container mt-3">
<nav>
<ol class="breadcrumb">
<li class="breadcrumb-item"><a href="#">Home</a></li>
<li class="breadcrumb-item active">Page</li>
</ol>
</nav>
</div>

<div class="hero">
<h1>Welcome to My Website</h1>
<p>Simple, Attractive & Responsive Design</p>
<button class="btn btn-light mt-2" data-bs-toggle="modal" data-bs-target="#myModal">
Learn More
</button>
</div>

<div class="container mt-5">
<div class="row text-center">

<div class="col-md-4 mb-3">
<div class="card shadow">
<div class="card-body">
<h5>Web Design</h5>
<p>Creative and modern designs.</p>
</div>
</div>
</div>

<div class="col-md-4 mb-3">
<div class="card shadow">
<div class="card-body">
<h5>Development</h5>
<p>Fast and responsive websites.</p>
</div>
</div>
</div>

<div class="col-md-4 mb-3">
<div class="card shadow">
<div class="card-body">
<h5>SEO</h5>
<p>Improve your visibility online.</p>
</div>
</div>
</div>

</div>
</div>

<div class="container mt-5">
<h3 class="text-center mb-3">Contact Us</h3>

<form>
<input class="form-control mb-2" type="text" placeholder="Name">
<input class="form-control mb-2" type="email" placeholder="Email">
<textarea class="form-control mb-2" placeholder="Message"></textarea>
<button class="btn btn-primary w-100">Submit</button>
</form>
</div>

<div class="modal fade" id="myModal">
<div class="modal-dialog">
<div class="modal-content">

<div class="modal-header">
<h5 class="modal-title">About Us</h5>
<button class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
<p>This is a simple Bootstrap website for learning purpose.</p>
</div>

</div>
</div>
</div>

</body>
</html>
