<html>
<head>
<title>green Boxes</title>
<style>
body {
    margin:0;
    font-family:Arial,sans-serif;
    background: lightyellow;
    text-align:center;
}
header {
    background: green;
    color:white;
    padding:15px;
}
.container {
    display:flex;
    justify-content:center;
    gap:20px;
    padding:20px;
}
.box {
    border:2px solid green;
    border-radius:10px;
    width:350px;
    height:250px;
    box-shadow:2px 2px gray;
    overflow:hidden;
    transition: transform 0.3s, box-shadow 0.3s;
}
.box:hover {
    transform: scale(1.05);
    box-shadow:4px 4px 12px darkgray;
}
iframe {width:100%; height:100%; border:none;}
h2 {text-shadow:1px 1px gray;}
</style>
</head>
<body>

<header>
<h1>Pages / Maps</h1>
</header>

<h2>Click inside the boxes to interact</h2>
<div class="container">

<div class="box">
<div class="box-title">Google Maps</div>
<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d29766.72289275705!2d79.06355793955078!3d21.158750400000017!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd4c0c011f8b8d1%3A0x5ce2c1fced484232!2sTitan%20World!5e0!3m2!1sen!2sin!4v1776532934949!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>"></iframe>
</div>

<div class="box">
<div class="box-title">Example Website</div>
<iframe src="https://www.sbjit.edu.in/"></iframe>
</div>

<div class="box">
 <div class="box-title">Wikipedia</div>
<iframe src="https://www.wikipedia.org"></iframe>
</div>

</div>

</body>
</html>
