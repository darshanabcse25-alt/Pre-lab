 <input type="email" placeholder="Email"><br><br>
 <i class="fas fa-phone"></i> 
 <input type="text" placeholder="Phone">
 </div>
</div>
<div id="about" class="section">
 <div class="box"><i class="fas fa-user"></i> About Content</div>
</div>
